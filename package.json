{
  "name": "infomaniak-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server exposing the Infomaniak public API (hosting, domains, kDrive, mail, AI Tools…) to MCP-compatible clients like Claude.",
  "type": "module",
  "bin": {
    "infomaniak-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  }
}
