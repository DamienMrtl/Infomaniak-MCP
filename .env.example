# Personal API token, created at https://manager.infomaniak.com → "API Token Manager".
# Scope it to the products you want Claude to manage (hosting, domain, drive, mail, ai…).
INFOMANIAK_API_TOKEN=

# Optional. Override the API base URL (default: https://api.infomaniak.com).
# INFOMANIAK_API_BASE_URL=https://api.infomaniak.com

# Optional. Default AI product UUID for infomaniak_ai_chat / infomaniak_ai_list_models.
# INFOMANIAK_AI_PRODUCT_ID=

# Optional. Transport: "stdio" (default, local/Claude Desktop) or "http" (remote).
# TRANSPORT=stdio

# Optional. When TRANSPORT=http.
# HOST=127.0.0.1
# PORT=3000
